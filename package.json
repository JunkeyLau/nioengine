{
  "name": "nioengine",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "description": "Engine Sound Lab — P1 cockpit + P0 capability probe",
  "scripts": {
    "build": "node build.mjs",
    "serve": "python3 -m http.server 4173 --directory dist",
    "build:p1": "node p1/build.mjs",
    "serve:p1": "python3 -m http.server 4174 --directory p1/dist",
    "build:all": "npm run build:p1 && npm run build && node scripts/assemble.mjs",
    "preview": "wrangler dev",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}

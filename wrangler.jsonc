{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nioengine",
  "main": "worker.mjs",
  "compatibility_date": "2025-01-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
